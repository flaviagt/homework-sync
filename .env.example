# Copy to secrets.env for local runs — secrets.env is gitignored.
# In GitHub Actions these come from repository secrets instead.
CANVAS_ICS_URL=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# For the Gradescope export (python -m homework_sync.gradescope_export).
GRADESCOPE_EMAIL=
GRADESCOPE_PASS=
# Optional: turns on the Claude fallback for course sites whose layout changes.
ANTHROPIC_API_KEY=
